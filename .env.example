# LLM (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Note: as of mid-2026, gemini-1.5-flash has been retired (404). Stick with
# gemini-2.0-flash or check https://ai.google.dev/gemini-api/docs/models
# for current model names.

# Server
PORT=3000

# Meta (Messenger / Instagram) - fill in when ready for Phase 2
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# Shopify (mocked by default; set to enable real calls)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_TOKEN=
